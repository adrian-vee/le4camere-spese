# Supabase (Project Settings -> API)
# Accepts either PUBLISHABLE_KEY or ANON_KEY (Vercel integration uses ANON_KEY)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx_or_anon_key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Anthropic (per l'OCR degli scontrini) — solo lato server, NON con NEXT_PUBLIC_
ANTHROPIC_API_KEY=sk-ant-xxx
